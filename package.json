{
  "name": "@tklu/pi-egm",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "description": "Draft specs, review designs, and check implementation drift.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "skills",
    "spec-driven-development",
    "design-documents",
    "design-review",
    "goldfish",
    "elephant"
  ],
  "author": {
    "name": "Google"
  },
  "homepage": "https://egm.dev",
  "repository": "https://github.com/google/elephant-goldfish-model",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/persona-registry.test.ts tests/index-integration.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "./assets/icon.svg"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "FORK.md",
    "assets/icon.svg",
    "index.ts",
    "persona-registry.ts",
    "skills/",
    "!skills/**/TEST.md",
    "!skills/**/test_scenarios.yaml",
    "agents/",
    "resources/",
    "docs/getting_started.md",
    "docs/harnesses.md"
  ]
}
