{
  "name": "@tklu/pi-egm",
  "version": "0.5.2",
  "type": "module",
  "description": "Draft specs, review designs, and check implementation drift.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "skills",
    "spec-driven-development",
    "design-documents",
    "design-review",
    "goldfish",
    "elephant"
  ],
  "author": "tklu",
  "contributors": [
    "Google (upstream EGM)",
    "rizkiaprita (original Pi port)"
  ],
  "homepage": "https://github.com/dei03236/pi-egm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dei03236/pi-egm.git"
  },
  "bugs": {
    "url": "https://github.com/dei03236/pi-egm/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/persona-registry.test.ts tests/index-integration.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "./assets/icon.svg"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "assets/icon.svg",
    "index.ts",
    "persona-registry.ts",
    "skills/",
    "!skills/**/TEST.md",
    "!skills/**/test_scenarios.yaml",
    "agents/",
    "resources/",
    "docs/getting_started.md",
    "docs/harnesses.md"
  ]
}
